# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build outputs
dist/
build/
out/
target/
*.min.js
*.min.css

# TypeScript compilation outputs (CDK)
**/cdk/lib/*.js
**/cdk/lib/*.d.ts
**/cdk/bin/*.js
**/cdk/bin/*.d.ts

# TypeScript compilation outputs (shared utils): aws-utils.ts is the source;
# tsc emits aws-utils.js / aws-utils.d.ts next to it on every CDK build, which
# otherwise show up as perpetually-untracked files. The .ts/.py/.sh sources are
# tracked; the compiled JS/d.ts are not.
shared/utils/*.js
shared/utils/*.d.ts

# CDK outputs
**/cdk.out/
**/cdk.out*/
cdk.out/
cdk.out*/

# AI Documentation Generation outputs
**/generated-docs-*/

# Graviton Migration Assessment outputs
**/graviton-assessment-*/
**/latest-assessment/

