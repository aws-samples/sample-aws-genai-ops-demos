#!/usr/bin/env bash
# Seed the demo schema used by the deadlock / memory / replica-lag scenarios.
set -uo pipefail
source "$(dirname "$0")/lib.sh"

echo "Seeding demo schema on writer ($WRITER_ENDPOINT)..."
mysql_w <<'SQL'
CREATE TABLE IF NOT EXISTS accounts (id INT PRIMARY KEY, balance BIGINT);
INSERT IGNORE INTO accounts VALUES (1, 1000000), (2, 1000000);
CREATE TABLE IF NOT EXISTS bigtab (id INT PRIMARY KEY AUTO_INCREMENT, payload VARCHAR(255));
CREATE TABLE IF NOT EXISTS churn (id INT PRIMARY KEY AUTO_INCREMENT, payload VARCHAR(1024));
SQL

CNT="$(mysql_w -N -e 'SELECT COUNT(*) FROM bigtab;' 2>/dev/null || echo 0)"
if [[ "${CNT:-0}" -lt 100000 ]]; then
  echo "Populating bigtab (~200k rows) — this can take a minute..."
  mysql_w -e "INSERT INTO bigtab (payload) SELECT LEFT(MD5(RAND()),200) FROM information_schema.columns a, information_schema.columns b LIMIT 200000;"
fi

echo "Seed complete. bigtab rows: $(mysql_w -N -e 'SELECT COUNT(*) FROM bigtab;' 2>/dev/null)"
