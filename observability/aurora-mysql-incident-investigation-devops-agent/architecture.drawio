<mxfile host="Kiro" agent="drawio-starter" version="24.0.0">
  <diagram id="aurora-incident" name="Aurora Incident Investigation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- VPC container -->
        <mxCell id="vpc" value="VPC (2 AZs, no NAT)" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#8C4FFF;dashed=0;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;fontSize=12;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="500" height="360" as="geometry" />
        </mxCell>
        <mxCell id="pubsub" value="Public subnet" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#7AA116;dashed=0;verticalAlign=top;align=left;spacingLeft=30;fontColor=#7AA116;fontSize=11;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_public_subnet;" vertex="1" parent="1">
          <mxGeometry x="330" y="210" width="190" height="120" as="geometry" />
