# CDK context cache contains the AWS account ID and region-specific lookups.
# Regenerated on every `npx cdk synth`.
cdk/cdk.context.json

# ASH scan output — large, per-run, regenerated on every scan.
.ash/ash_output/

# Local IDE / tool caches.
.claude/
.playwright-mcp
# UI audit screenshots / snapshots — captured ad-hoc; not part of the demo
ui-audit/

# The repo root ignores lockfiles. This one is committed so the frontend installs the exact
# Cloudscape versions the One Theme port (frontend/src/one-theme) was generated for.
!frontend/package-lock.json
