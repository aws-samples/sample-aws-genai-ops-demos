        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid: synchronous call&lt;br&gt;Dashed: event-driven or cross-account&lt;br&gt;&lt;br&gt;The browser holds no AWS credentials.&lt;br&gt;main is never written and no Lambda&lt;br&gt;function is modified: the flow ends&lt;br&gt;at a pushed upgrade branch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#AAB7B8;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="1450" y="480" width="220" height="160" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>