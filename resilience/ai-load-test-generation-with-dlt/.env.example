# Copy to .env for local runs. In AgentCore the execution role supplies
# credentials — do NOT bake keys into the image or the deployed runtime.

# Prefer a profile over raw keys. Raw keys in .env are for local dev only.
AWS_PROFILE=default
AWS_REGION=<your-region>

# Bedrock. Both are optional:
#   BEDROCK_REGION       — only if you invoke models in a different region than
#                          AWS_REGION (e.g. the model is not available locally).
#   BEDROCK_MODEL_*      — only to pin a specific model. Left unset, the agent
#                          derives the inference profile ID from the region
#                          (us./eu./apac./global.), which is what you want.
# Base model IDs are NOT invokable on demand — always a profile ID.
# BEDROCK_REGION=<region-where-the-model-is-enabled>
# BEDROCK_MODEL_PRIMARY=<prefix>.anthropic.claude-opus-4-8
# BEDROCK_MODEL_FALLBACK=<prefix>.anthropic.claude-sonnet-5

# DLT — stack coordinates only; bucket/API endpoint are discovered at runtime
# (T7 discover_dlt_config). Never hardcode bucket names.
DLT_STACK_NAME=<your-dlt-stack-name>
DLT_REGION=<region-where-dlt-is-deployed>
