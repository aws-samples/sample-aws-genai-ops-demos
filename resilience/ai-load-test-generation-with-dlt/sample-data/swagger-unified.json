            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentMethodResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/queue/{concertId}/enter": {
      "post": {
        "tags": [
