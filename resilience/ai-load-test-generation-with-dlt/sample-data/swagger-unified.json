  "components": {
    "schemas": {
      "SignUpRequest": {
        "required": [
          "email",
          "name",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 255,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 2147483647,
            "minLength": 8,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "UserResponse": {
        "required": [
          "createdAt",
          "email",
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "TokenResponse": {
        "required": [
          "accessToken",
          "expiresIn"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Unit": {
        "type": "object"
      },
      "ConcertSummaryResponse": {
        "required": [
          "availableSeats",
          "concertDate",
          "concertTime",
          "id",
          "isReservable",
          "price",
          "title",
          "venue"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "concertDate": {
            "type": "string",
            "format": "date"
          },
          "concertTime": {
            "$ref": "#/components/schemas/LocalTime"
          },
          "price": {
            "type": "number"
          },
          "availableSeats": {
            "type": "integer",
            "format": "int32"
          },
          "isReservable": {
            "type": "boolean"
          }
        }
      },
      "LocalTime": {
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer",
            "format": "int32"
          },
          "minute": {
            "type": "integer",
            "format": "int32"
          },
          "second": {
            "type": "integer",
            "format": "int32"
          },
          "nano": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PageResponseConcertSummaryResponse": {
        "required": [
          "content",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConcertSummaryResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ConcertDetailResponse": {
        "required": [
          "availableSeats",
          "concertDate",
          "concertTime",
          "id",
          "isReservable",
          "price",
          "title",
          "totalSeats",
          "venue"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "concertDate": {
            "type": "string",
            "format": "date"
          },
          "concertTime": {
            "$ref": "#/components/schemas/LocalTime"
          },
          "price": {
            "type": "number"
          },
          "totalSeats": {
            "type": "integer",
            "format": "int32"
          },
          "availableSeats": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string"
          },
          "isReservable": {
            "type": "boolean"
          }
        }
      },
      "ProcessPaymentRequest": {
        "required": [
          "amount",
          "paymentMethodId",
          "reservationId"
        ],
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "integer",
            "format": "int64"
          },
          "paymentMethodId": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "PaymentResponse": {
        "required": [
          "amount",
          "createdAt",
          "id",
          "reservationId",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "reservationId": {
            "type": "integer",
            "format": "int64"
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentMethodResponse": {
        "required": [
          "cardNumber",
          "cardType",
          "expiryDate",
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "cardNumber": {
            "type": "string"
          },
          "expiryDate": {
            "type": "string"
          },
          "cardType": {
            "type": "string"
          }
        }
      },
      "QueueEntryResult": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ENTERED",
              "WAITING"
            ]
          },
          "position": {
            "type": "integer",
            "format": "int64"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "QueuePositionInfo": {
        "required": [
          "estimatedWaitSeconds",
          "position"
        ],
        "type": "object",
        "properties": {
          "position": {
            "type": "integer",
            "format": "int64"
          },
          "estimatedWaitSeconds": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ServerSentEventString": {
        "type": "object"
      },
      "CreateReservationRequest": {
        "required": [
          "concertId",
          "paymentMethodId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "concertId": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "paymentMethodId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ReservationResponse": {
        "required": [
          "concertId",
          "concertTitle",
          "createdAt",
          "id",
          "quantity",
          "status",
          "totalAmount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "concertId": {
            "type": "integer",
            "format": "int64"
          },
          "concertTitle": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "totalAmount": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReservationListResponse": {
        "required": [
          "concertId",
          "createdAt",
          "id",
          "quantity",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "concertId": {
            "type": "integer",
            "format": "int64"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
