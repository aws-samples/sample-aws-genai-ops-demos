# Keep the container build context minimal. Critically excludes CDK output and
# venvs (which live under the repo) so DockerImageAsset staging never recurses
# into cdk.out. Also trims dirs the image does not need.
.git
infrastructure
**/cdk.out
cdk.out
.venv
**/.venv
**/__pycache__
**/*.pyc
.mypy_cache
test
# `test` only matches the top-level dir, so builder/tests/ shipped in the image
# even though it is never executed there. Same for the sample specs they read.
**/tests
**/sample-data
# sample/ is untracked but still on disk locally, and the .jmx files in it carry
# live credentials. The build context reads the filesystem, not git — keep it out.
sample
sample-data
node_modules
infra/build
*.log
